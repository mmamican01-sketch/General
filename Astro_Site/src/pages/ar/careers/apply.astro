---
import BaseLayout from "../../../layouts/BaseLayout.astro";
const locale = "ar";
---

<BaseLayout locale={locale} title="التقديم لوظيفة">
  <main class="mx-auto max-w-[1400px] px-8 py-16">
    <h1 class="text-3xl font-semibold text-[#2c2c2c]">التقديم لوظيفة</h1>
    <p class="mt-3 text-[#2c2c2c] opacity-80">صفحة مؤقتة (سيتم تعبئتها في مرحلة لاحقة).</p>
  </main>
</BaseLayout>
