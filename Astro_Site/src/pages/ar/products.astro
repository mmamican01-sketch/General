---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="المنتجات والخدمات | Placeholder"
  description="Placeholder page description."
  lang="ar"
  dir="rtl"
  locale="ar"
  currentPath="products"
>
  <section class="rounded-lg border border-slate-200 bg-slate-50 p-6">
    <p class="text-sm text-slate-500">الرئيسية / المنتجات / Placeholder</p>
    <h1 class="mt-3 text-3xl font-semibold text-slate-900">المنتجات والخدمات</h1>
  </section>

  <section class="mt-8 grid gap-4 md:grid-cols-3">
    <div class="rounded-lg border border-slate-200 p-5">Section 01 card placeholder</div>
    <div class="rounded-lg border border-slate-200 p-5">Section 01 card placeholder</div>
    <div class="rounded-lg border border-slate-200 p-5">Section 01 card placeholder</div>
  </section>

  <section class="mt-8 grid gap-4 md:grid-cols-2">
    <div class="rounded-lg border border-slate-200 p-5">Section 02 column placeholder</div>
    <div class="rounded-lg border border-slate-200 p-5">Section 02 column placeholder</div>
  </section>

  <section class="mt-8 rounded-lg border border-slate-200 p-6">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="h-20 rounded bg-slate-100"></div>
      <div class="h-20 rounded bg-slate-100"></div>
      <div class="h-20 rounded bg-slate-100"></div>
      <div class="h-20 rounded bg-slate-100"></div>
    </div>
  </section>

  <section class="mt-8 rounded-lg border border-slate-200 p-6">
    <div class="grid gap-4 md:grid-cols-3">
      <div class="h-24 rounded bg-slate-100"></div>
      <div class="h-24 rounded bg-slate-100"></div>
      <div class="h-24 rounded bg-slate-100"></div>
    </div>
  </section>

  <section class="mt-8 rounded-lg bg-slate-900 p-6 text-white">
    <p class="text-sm uppercase tracking-wide text-slate-300">Primary CTA Placeholder</p>
    <a
      href="/ar/contact"
      class="mt-3 inline-flex items-center rounded-md bg-white px-4 py-2 text-sm font-medium text-slate-900"
    >
      CTA Button Placeholder
    </a>
  </section>
</BaseLayout>
