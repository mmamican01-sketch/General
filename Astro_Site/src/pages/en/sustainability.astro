---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadPageContent, getSlot } from "../../lib/contentStore";

const content = await loadPageContent("sustainability");
---

<BaseLayout
  title="Sustainability | Structured Institutional Positioning — ALFArhan"
  description="Sustainability positioning across intermediary engagement models, focus areas, standards, and institutional commitments."
  lang="en"
  dir="ltr"
  locale="en"
  currentPath="sustainability"
>
  <div class="w-full">
    <section class="w-full section-white pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24">
      <div class="max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl sm:text-4xl lg:text-6xl mb-6 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;" data-slot="hero-title">{getSlot(content, "hero-title", "Sustainability")}</h1>
        <p class="text-lg text-[#5c5c5c] max-w-3xl" style="font-family: Inter, sans-serif" data-slot="hero-description">{getSlot(content, "hero-description", "Responsible trading practices across our supply chain operations.")}</p>
      </div>
    </section>

    <section class="w-full bg-[var(--bg-section)] pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24 mt-12 sm:mt-16 lg:mt-24">
      <div class="max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-6 sm:mb-8 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;" data-slot="section-1-title">{getSlot(content, "section-1-title", "Approach")}</h2>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12">
          <div class="md:col-span-6">
            <p class="text-base text-[#5c5c5c] leading-relaxed mb-5" style="font-family: Inter, sans-serif" data-slot="section-1-body-1">{getSlot(content, "section-1-body-1", "AFGT integrates sustainability considerations into commodity sourcing, supply chain management, and trading operations. The company works with partners who maintain recognized environmental and social standards.")}</p>
            <p class="text-base text-[#5c5c5c] leading-relaxed" style="font-family: Inter, sans-serif" data-slot="section-1-body-2">{getSlot(content, "section-1-body-2", "Sustainability practices are assessed through supplier audits, certification verification, and operational monitoring across the supply chain.")}</p>
          </div>
          <div class="md:col-span-6">
            <p class="text-base text-[#5c5c5c] leading-relaxed mb-5" style="font-family: Inter, sans-serif" data-slot="section-1-body-3">{getSlot(content, "section-1-body-3", "The company prioritizes long-term partnerships with producers and logistics providers who demonstrate commitment to sustainable practices and transparent operations.")}</p>
            <p class="text-base text-[#5c5c5c] leading-relaxed" style="font-family: Inter, sans-serif" data-slot="section-1-body-4">{getSlot(content, "section-1-body-4", "AFGT participates in industry initiatives aimed at improving sustainability standards across global commodity markets.")}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="w-full section-white pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24 mt-12 sm:mt-16 lg:mt-24">
      <div class="max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-6 sm:mb-10 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
          Focus areas
        </h2>

        <div class="space-y-12">
          <div>
            <h3 class="text-xl sm:text-2xl mb-3 sm:mb-4 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
              Environment
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8">
              <div class="md:col-span-6">
                <p class="text-sm text-[#5c5c5c] leading-relaxed" style="font-family: Inter, sans-serif">
                  AFGT monitors environmental impact across sourcing and logistics operations. The company works with certified suppliers and transportation partners who maintain documented environmental management systems.
                </p>
              </div>
              <div class="md:col-span-6">
                <p class="text-sm text-[#5c5c5c] leading-relaxed" style="font-family: Inter, sans-serif">
                  Carbon footprint tracking is applied to maritime transport operations. Route optimization and vessel efficiency are integrated into logistics planning.
                </p>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-xl sm:text-2xl mb-3 sm:mb-4 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
              Supply chain
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8">
              <div class="md:col-span-6">
                <p class="text-sm text-[#5c5c5c] leading-relaxed" style="font-family: Inter, sans-serif">
                  Supplier due diligence includes verification of environmental certifications, labor practices, and traceability documentation. Third-party audits are conducted where required by industry standards.
                </p>
              </div>
              <div class="md:col-span-6">
                <p class="text-sm text-[#5c5c5c] leading-relaxed" style="font-family: Inter, sans-serif">
                  AFGT maintains direct relationships with producers to ensure visibility into sourcing practices and adherence to sustainability commitments.
                </p>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-xl sm:text-2xl mb-3 sm:mb-4 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
              People
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8">
              <div class="md:col-span-6">
                <p class="text-sm text-[#5c5c5c] leading-relaxed" style="font-family: Inter, sans-serif">
                  The company maintains workplace safety standards and professional development programs for employees across all operational locations.
                </p>
              </div>
              <div class="md:col-span-6">
                <p class="text-sm text-[#5c5c5c] leading-relaxed" style="font-family: Inter, sans-serif">
                  AFGT expects all partners and suppliers to comply with labor laws, fair employment practices, and health and safety regulations.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="w-full bg-[var(--bg-section)] pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24 mt-12 sm:mt-16 lg:mt-24">
      <div class="max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-6 sm:mb-8 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
          Standards & commitments
        </h2>

        <div class="space-y-4">
          <div class="pb-4 border-b border-gray-300">
            <h3 class="text-lg mb-2 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
              ISO 14001 Environmental Management
            </h3>
            <p class="text-sm text-[#5c5c5c]" style="font-family: Inter, sans-serif">
              Applied to operational facilities and logistics partners where applicable.
            </p>
          </div>

          <div class="pb-4 border-b border-gray-300">
            <h3 class="text-lg mb-2 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
              Sustainable Agriculture Certifications
            </h3>
            <p class="text-sm text-[#5c5c5c]" style="font-family: Inter, sans-serif">
              Verification of supplier certifications including Bonsucro, RSPO, and RTRS where relevant to commodity sourcing.
            </p>
          </div>

          <div class="pb-4 border-b border-gray-300">
            <h3 class="text-lg mb-2 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
              UN Global Compact
            </h3>
            <p class="text-sm text-[#5c5c5c]" style="font-family: Inter, sans-serif">
              Alignment with principles covering human rights, labor, environment, and anti-corruption.
            </p>
          </div>

          <div class="pb-4">
            <h3 class="text-lg mb-2 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
              Code of Conduct
            </h3>
            <p class="text-sm text-[#5c5c5c]" style="font-family: Inter, sans-serif">
              Internal policies governing ethical business practices, anti-bribery measures, and regulatory compliance.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="w-full section-white pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24 mt-12 sm:mt-16 lg:mt-24">
      <div class="max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-6 sm:mb-8 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
          Reporting & transparency
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8">
          <div class="md:col-span-6">
            <p class="text-base text-[#5c5c5c] leading-relaxed mb-5" style="font-family: Inter, sans-serif">
              AFGT publishes annual sustainability reports documenting progress across environmental, social, and governance metrics.
            </p>
            <p class="text-sm text-[#5c5c5c]" style="font-family: Inter, sans-serif">
              <a href="#" class="link-accent hover:text-[#2c2c2c] transition-colors">
                Annual Sustainability Report 2025
              </a>
            </p>
          </div>
          <div class="md:col-span-6">
            <p class="text-base text-[#5c5c5c] leading-relaxed mb-5" style="font-family: Inter, sans-serif">
              Sustainability performance data is independently verified and aligned with global reporting frameworks.
            </p>
            <p class="text-sm text-[#5c5c5c]" style="font-family: Inter, sans-serif">
              <a href="#" class="link-accent hover:text-[#2c2c2c] transition-colors">
                Sustainability Policy Framework
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
