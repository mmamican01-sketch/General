            </ul>
          </div>
        </div>
        <div>
          <h4 class="text-sm mb-1 text-white" style="font-family: Inter, sans-serif">Legal</h4>
          <ul class="space-y-1">
            <li><a href="#" class="text-sm text-white/80 hover:text-white transition-colors" style="font-family: Inter, sans-serif">Privacy Policy</a></li>
            <li><a href="#" class="text-sm text-white/80 hover:text-white transition-colors" style="font-family: Inter, sans-serif">Terms of Service</a></li>
