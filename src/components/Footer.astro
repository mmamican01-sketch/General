          </ul>
        </div>
      </div>
    </div>

    <!-- Desktop: original grid layout -->
    <div class="hidden md:grid grid-cols-12 gap-4 sm:gap-6">
      <div class="md:col-span-3">
        <a href={withBase(localeBase)} class="inline-block">
          {footerLogo ? (
            <img src={footerLogo ? withBase(footerLogo) : ''} alt="AFGT" class="block max-h-[156px] w-auto sm:max-h-[76px] sm:w-[420px] sm:h-[138px] md:max-h-none md:w-[560px] md:h-[184px] object-contain" />
