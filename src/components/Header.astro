---
const { locale = "en", currentPath = "" } = Astro.props;

const base = locale === "ar" ? "/ar" : "/en";

function buildHref(path: string) {
  const p = path ? `${base}/${path}` : base;
  return p.replace(/\/+$/, "") || base;
}

function isActive(path: string) {
  const normalized = currentPath.replace(/\/+$/, "") || "";
  const normalizedPath = path.replace(/\/+$/, "") || "";
  return normalized === normalizedPath || (normalizedPath && normalized.startsWith(normalizedPath + "/"));
}
---

<header class="w-full bg-white">
  <!-- Utility Bar - Tier A -->
  <div class="w-full bg-[#f5f5f5]">
    <div class="max-w-[1400px] mx-auto px-8 py-3">
      <div class="flex justify-end items-center gap-8">
        <a href="#" class="flex items-center gap-1 text-sm text-[#2c2c2c] hover:text-[#000] transition-colors">
          Apply for a role
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <a href="#" class="text-sm text-[#2c2c2c] hover:text-[#000] transition-colors">
          Newsroom
        </a>
        <a href={buildHref("contact")} class="text-sm text-[#2c2c2c] hover:text-[#000] transition-colors">
          Contact Us
        </a>
        <button class="flex items-center gap-1 text-sm text-[#2c2c2c] hover:text-[#000] transition-colors">
          Global sites
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <button class="bg-[#2c2c2c] p-2 hover:bg-[#000] transition-colors" aria-label="Search">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="8" stroke-width="2"></circle>
            <path d="m21 21-4.3-4.3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Primary Header - Tier B -->
  <div class="w-full bg-white border-b border-gray-200">
    <div class="max-w-[1400px] mx-auto px-8 py-6">
      <div class="flex items-center justify-between">
        <a href={base} class="flex items-center gap-3">
          <div class="w-10 h-10 bg-gradient-to-br from-blue-600 via-blue-500 to-teal-400 clip-polygon"></div>
          <span class="text-2xl tracking-tight" style="font-family: Inter, sans-serif">AFGT</span>
        </a>

        <nav class="flex items-center gap-12">
          <a href={buildHref("who-we-are")} class="text-[#2c2c2c] hover:text-[#000] transition-colors" style="font-family: Cormorant Garamond, serif" aria-current={isActive("who-we-are") ? "page" : undefined}>
            Who we are
          </a>
          <a href={buildHref("products")} class="text-[#2c2c2c] hover:text-[#000] transition-colors" style="font-family: Cormorant Garamond, serif" aria-current={isActive("products") ? "page" : undefined}>
            Products & Services
          </a>
          <a href={buildHref("sustainability")} class="text-[#2c2c2c] hover:text-[#000] transition-colors" style="font-family: Cormorant Garamond, serif" aria-current={isActive("sustainability") ? "page" : undefined}>
            Sustainability
          </a>
          <a href={buildHref("careers")} class="text-[#2c2c2c] hover:text-[#000] transition-colors" style="font-family: Cormorant Garamond, serif" aria-current={isActive("careers") ? "page" : undefined}>
            Careers
          </a>
        </nav>
      </div>
    </div>
  </div>
</header>
