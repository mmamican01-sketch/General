---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="الوظائف | نمو الفرق المؤسسية — AFGT"
  description="إطار الوظائف في AFGT ويشمل ثقافة العمل، والفرص المتاحة، وآلية التقديم، ومسار التواصل."
  lang="ar"
  dir="rtl"
  locale="ar"
  currentPath="careers"
>
  <section class="py-24 bg-[#1b2230]">
    <div class="mx-auto max-w-[1140px] px-8">
      <h1 class="font-serif text-5xl text-white" style="font-weight:400; line-height:1.2;">
        الوظائف
      </h1>
      <p class="mt-8 max-w-3xl text-lg leading-8 text-white/80">
        صُممت المسارات المهنية في AFGT للكوادر التي تعمل ضمن بيئات وساطة منظمة ومتوافقة مع متطلبات العمل المؤسسي.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="mx-auto max-w-[1140px] px-8">
      <h2 class="font-serif text-4xl text-[#1b2230]" style="font-weight:400; line-height:1.2;">
        العمل في AFGT
      </h2>
      <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-3">
        <div>
          <h3 class="font-serif text-2xl text-[#1b2230]" style="font-weight:400;">الاحترافية</h3>
          <p class="mt-4 text-slate-600 leading-8">معايير مؤسسية عالية في الاتصال والتوثيق والاستعداد التنفيذي.</p>
        </div>
        <div>
          <h3 class="font-serif text-2xl text-[#1b2230]" style="font-weight:400;">الهيكلية</h3>
          <p class="mt-4 text-slate-600 leading-8">وضوح للأدوار وانضباط للإجراءات ضمن مسارات الوساطة المنظمة.</p>
        </div>
        <div>
          <h3 class="font-serif text-2xl text-[#1b2230]" style="font-weight:400;">خبرة عالمية</h3>
          <p class="mt-4 text-slate-600 leading-8">تعرض عملي لتنسيق الأسواق عبر ممرات انخراط سلع دولية متنوعة.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-[#f8f8f8]">
    <div class="mx-auto max-w-[1140px] px-8">
      <h2 class="font-serif text-4xl text-[#1b2230]" style="font-weight:400; line-height:1.2;">
        الوظائف المفتوحة
      </h2>
      <ul class="mt-10 space-y-6">
        <li class="border-b border-slate-200 pb-6">
          <h3 class="font-serif text-2xl text-[#1b2230]" style="font-weight:400;">محلل انخراط منظم</h3>
          <a href="/ar/careers/apply" class="mt-4 inline-block border-b border-[#1b2230] pb-1 text-[#1b2230] transition-colors hover:text-slate-600">
            إرسال طلب
          </a>
        </li>
        <li class="border-b border-slate-200 pb-6">
          <h3 class="font-serif text-2xl text-[#1b2230]" style="font-weight:400;">مساعد تنسيق التوثيق</h3>
          <a href="/ar/careers/apply" class="mt-4 inline-block border-b border-[#1b2230] pb-1 text-[#1b2230] transition-colors hover:text-slate-600">
            إرسال طلب
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="py-24 bg-[#1b2230]">
    <div class="mx-auto max-w-[1140px] px-8">
      <h2 class="font-serif text-4xl text-white" style="font-weight:400; line-height:1.2;">
        آلية التقديم
      </h2>
      <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-3">
        <div>
          <h3 class="font-serif text-2xl text-white" style="font-weight:400;">الخطوة 01</h3>
          <p class="mt-4 text-white/80 leading-8">إرسال طلب الاهتمام الوظيفي مع نبذة مهنية موجزة.</p>
        </div>
        <div>
          <h3 class="font-serif text-2xl text-white" style="font-weight:400;">الخطوة 02</h3>
          <p class="mt-4 text-white/80 leading-8">مراجعة أولية للمواءمة المؤسسية ومناقشة نطاق الدور.</p>
        </div>
        <div>
          <h3 class="font-serif text-2xl text-white" style="font-weight:400;">الخطوة 03</h3>
          <p class="mt-4 text-white/80 leading-8">تنسيق الخطوات التالية بوضوح إجرائي واستعداد تشغيلي.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-32 bg-[#2c2c2c]">
    <div class="mx-auto max-w-[1140px] px-8 text-center">
      <h2 class="font-serif text-4xl text-white" style="font-weight:400; line-height:1.2;">
        الأسئلة / التواصل
      </h2>
      <a
        href="/ar/contact"
        class="mt-12 inline-block rounded-full border border-white bg-white px-10 py-4 text-[#1b2230] transition-colors hover:bg-transparent hover:text-white"
      >
        تواصل معنا
      </a>
    </div>
  </section>
</BaseLayout>
