---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
---

<BaseLayout
  title="Careers | Institutional Team Growth — ALFArhan"
  description="Careers framework at AFGT covering operating culture, open positions, application process, and contact pathway."
  lang="en"
  dir="ltr"
  locale="en"
  currentPath="careers"
>
  <section class="py-24 bg-[#1b2230]">
    <Container>
      <h1 class="font-serif text-5xl text-white" style="font-weight:400; line-height:1.2;" data-slot="hero-title">
        Careers
      </h1>
      <p class="mt-8 max-w-3xl text-lg leading-8 text-white/80" data-slot="hero-description"></p>
    </Container>
  </section>

  <section class="py-24 bg-white">
    <Container>
      <h2 class="font-serif text-4xl text-[#1b2230]" style="font-weight:400; line-height:1.2;" data-slot="section-2-title">
        Working At AFGT
      </h2>
      <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-3">
        <div>
          <h3 class="font-serif text-2xl text-[#1b2230]" style="font-weight:400;" data-slot="section-2-card-1-title">Professionalism</h3>
          <p class="mt-4 text-[#1b2230]/70 leading-8" data-slot="section-2-card-1-body"></p>
        </div>
        <div>
          <h3 class="font-serif text-2xl text-[#1b2230]" style="font-weight:400;" data-slot="section-2-card-2-title">Structure</h3>
          <p class="mt-4 text-[#1b2230]/70 leading-8" data-slot="section-2-card-2-body"></p>
        </div>
        <div>
          <h3 class="font-serif text-2xl text-[#1b2230]" style="font-weight:400;" data-slot="section-2-card-3-title">Global Exposure</h3>
          <p class="mt-4 text-[#1b2230]/70 leading-8" data-slot="section-2-card-3-body"></p>
        </div>
      </div>
    </Container>
  </section>

  <section class="py-24 bg-[#f8f8f8]">
    <Container>
      <h2 class="font-serif text-4xl text-[#1b2230]" style="font-weight:400; line-height:1.2;" data-slot="section-3-title">
        Open Positions
      </h2>
      <ul class="mt-10 space-y-6">
        <li class="border-b border-[#1b2230]/20 pb-6">
          <h3 class="font-serif text-2xl text-[#1b2230]" style="font-weight:400;">Structured Engagement Analyst</h3>
          <a href="/en/careers/apply" class="mt-4 inline-block border-b border-[#1b2230] pb-1 text-[#1b2230] transition-colors hover:text-[#1b2230]/70">
            Submit Inquiry
          </a>
        </li>
        <li class="border-b border-[#1b2230]/20 pb-6">
          <h3 class="font-serif text-2xl text-[#1b2230]" style="font-weight:400;">Documentation Coordination Associate</h3>
          <a href="/en/careers/apply" class="mt-4 inline-block border-b border-[#1b2230] pb-1 text-[#1b2230] transition-colors hover:text-[#1b2230]/70">
            Submit Inquiry
          </a>
        </li>
      </ul>
    </Container>
  </section>

  <section class="py-24 bg-[#1b2230]">
    <Container>
      <h2 class="font-serif text-4xl text-white" style="font-weight:400; line-height:1.2;" data-slot="section-4-title">
        Application Process
      </h2>
      <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-3">
        <div>
          <h3 class="font-serif text-2xl text-white" style="font-weight:400;" data-slot="section-4-step-1-title">Step 01</h3>
          <p class="mt-4 text-white/80 leading-8" data-slot="section-4-step-1-body"></p>
        </div>
        <div>
          <h3 class="font-serif text-2xl text-white" style="font-weight:400;" data-slot="section-4-step-2-title">Step 02</h3>
          <p class="mt-4 text-white/80 leading-8" data-slot="section-4-step-2-body"></p>
        </div>
        <div>
          <h3 class="font-serif text-2xl text-white" style="font-weight:400;" data-slot="section-4-step-3-title">Step 03</h3>
          <p class="mt-4 text-white/80 leading-8" data-slot="section-4-step-3-body"></p>
        </div>
      </div>
    </Container>
  </section>

  <section class="py-32 bg-[#2c2c2c]">
    <Container>
      <div class="text-center">
      <h2 class="font-serif text-4xl text-white" style="font-weight:400; line-height:1.2;" data-slot="cta-title">
        Questions / Contact
      </h2>
      <a
        href="/en/contact"
        class="mt-12 inline-block rounded-full border border-white bg-white px-10 py-4 text-[#1b2230] transition-colors hover:bg-transparent hover:text-white"
        data-slot="cta-link"
      >
        <span data-slot="cta-text">Request Buyer Access</span>
      </a>
      </div>
    </Container>
  </section>
</BaseLayout>
