---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact ALFArhan General Trading Co. | Buyer Inquiry & Access Request"
  description="Request buyer access and begin structured engagement for bulk commodity trade across supported markets."
  lang="en"
  dir="ltr"
  locale="en"
  currentPath="contact"
>
  <section class="py-24 bg-[#1b2230]">
    <div class="mx-auto max-w-[1140px] px-8">
      <h1 class="font-serif text-5xl text-white" style="font-weight:400; line-height:1.2;">Contact</h1>
      <p class="mt-8 max-w-3xl text-lg leading-8 text-white/80">Formal channel for institutional buyer access requests.</p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="mx-auto max-w-[1140px] px-8">
      <h2 class="font-serif text-4xl text-[#1b2230]" style="font-weight:400; line-height:1.2;">Buyer Access Requests</h2>
      <p class="mt-8 max-w-3xl text-lg leading-8 text-[#1b2230]/70">Submit inquiry scope, destination market, and required commodity category.</p>
    </div>
  </section>

  <section class="py-24 bg-[#f8f8f8]">
    <div class="mx-auto max-w-[1140px] px-8">
      <h2 class="font-serif text-4xl text-[#1b2230]" style="font-weight:400; line-height:1.2;">What To Include</h2>
      <p class="mt-8 max-w-3xl text-lg leading-8 text-[#1b2230]/70">Provide organization details, engagement timeline, and contact coordinates.</p>
    </div>
  </section>

  <section class="py-24 bg-[#1b2230]">
    <div class="mx-auto max-w-[1140px] px-8">
      <h2 class="font-serif text-4xl text-white" style="font-weight:400; line-height:1.2;">Response Framework</h2>
      <p class="mt-8 max-w-3xl text-lg leading-8 text-white/80">Initial acknowledgment and next-step alignment are issued through controlled communication flow.</p>
    </div>
  </section>

  <section class="py-32 bg-[#2c2c2c]">
    <div class="mx-auto max-w-[1140px] px-8 text-center">
      <h2 class="font-serif text-4xl text-white" style="font-weight:400; line-height:1.2;">Engage With AFGT</h2>
      <a
        href="/en/contact"
        class="mt-12 inline-block rounded-full border border-white bg-white px-10 py-4 text-[#1b2230] transition-colors hover:bg-transparent hover:text-white"
      >
        Request Buyer Access
      </a>
    </div>
  </section>
</BaseLayout>
