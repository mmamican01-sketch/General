---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MediaFrame from "../../components/MediaFrame.astro";
import { loadPageContent, getSlot, loadAllProducts } from "../../lib/contentStore";

const productDocs = loadAllProducts();
const products = productDocs.map((p) => ({
  name: p.title || p.slug,
  slug: p.slug,
  image: p.heroImage || "/assets/figma/media-default.svg",
}));

const content = await loadPageContent("index");
const heroVideo = getSlot(content, "hero-video", "");
function getYoutubeEmbedUrl(url: string): string {
  let id = "";
  if (url.includes("youtu.be/")) id = url.split("youtu.be/")[1]?.split("?")[0] || "";
  else if (url.includes("youtube.com/embed/")) id = url.split("embed/")[1]?.split("?")[0] || "";
  else if (url.includes("v=")) id = url.split("v=")[1]?.split("&")[0] || "";
  return id ? `https://www.youtube.com/embed/${id}?autoplay=1&mute=1&loop=1&playlist=${id}&controls=0&showinfo=0&playsinline=1` : "";
}
function getVimeoEmbedUrl(url: string): string {
  const id = url.split("vimeo.com/")[1]?.split("?")[0] || "";
  return id ? `https://player.vimeo.com/video/${id}?autoplay=1&loop=1&muted=1&background=1` : "";
}
const heroVideoEmbed = heroVideo.includes("youtube") || heroVideo.includes("youtu.be") ? getYoutubeEmbedUrl(heroVideo) : heroVideo.includes("vimeo.com") ? getVimeoEmbedUrl(heroVideo) : "";
const heroVideoDirect = heroVideo && /\.(mp4|webm|ogg)(\?|$)/i.test(heroVideo) ? heroVideo : "";
const heroTitle = getSlot(content, "hero-title", "We are AFGT");
const heroHref = getSlot(content, "hero-link", "/en/who-we-are");
const heroLinkLabel = getSlot(content, "hero-link-label", "Who we are");
const sectionTitle = getSlot(
  content,
  "section-1-title",
  "Building global trade partnerships across diverse commodity sectors"
);
const institutionalImage = getSlot(
  content,
  "section-2-image",
  "https://images.unsplash.com/photo-1760246964044-1384f71665b9?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxjb3Jwb3JhdGUlMjBvZmZpY2UlMjBidWlsZGluZyUyMG1vZGVybnxlbnwxfHx8fDE3NzA3MTE3MjV8MA&ixlib=rb-4.1.0&q=80&w=1080"
);
const institutionalTitle = getSlot(content, "section-2-title", "Institutional excellence");
const institutionalBody = getSlot(
  content,
  "section-2-body",
  "AL Farhan General Trading (AFGT) operates with the highest standards of institutional integrity across global markets. Our commitment to transparency and reliability defines every partnership."
);
---

<BaseLayout
  title="ALFArhan General Trading Co. | Commodities Intermediary"
  description="Buyer-oriented access to bulk commodity trade across sugar, wheat, barley, and sunflower oil."
  lang="en"
  dir="ltr"
  locale="en"
  currentPath=""
>
  <div class="w-full">
    <section class="relative w-full h-[75vh] bg-[var(--bg-section)] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-gray-800 to-gray-900"></div>
      {heroVideoEmbed && (
        <div class="absolute inset-0 z-0 [&_iframe]:absolute [&_iframe]:top-1/2 [&_iframe]:left-1/2 [&_iframe]:min-w-[177.78vh] [&_iframe]:min-h-[56.25vw] [&_iframe]:w-[100vw] [&_iframe]:h-[56.25vw] [&_iframe]:-translate-x-1/2 [&_iframe]:-translate-y-1/2">
          <iframe
            src={heroVideoEmbed}
            class="pointer-events-none"
            allow="autoplay; encrypted-media"
            allowfullscreen
            title="Hero background video"
          />
        </div>
      )}
      {heroVideoDirect && (
        <video
          src={heroVideoDirect}
          autoplay
          muted
          loop
          playsinline
          class="absolute inset-0 z-0 w-full h-full object-cover"
          aria-hidden="true"
        />
      )}
      <div class="relative z-10 flex flex-col justify-between items-center w-full h-full min-h-[75vh] px-8 py-10">
        {heroTitle ? (
          <h1 class="text-4xl sm:text-5xl lg:text-7xl text-white text-center" style="font-family: Cormorant Garamond, serif; font-weight: 400; line-height: 1.2;">
          {heroTitle}
        </h1>
        ) : (
          <div />
        )}
        <a
          href={heroHref}
          class="inline-block btn-primary px-8 py-3 shrink-0"
          style="font-family: Inter, sans-serif"
        >
          {heroLinkLabel}
        </a>
      </div>
    </section>

    <section class="w-full section-white pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24 mt-12 sm:mt-16 lg:mt-24">
      <div class="max-w-[1140px] mx-auto px-8 text-center">
        <h2 class="text-2xl sm:text-4xl lg:text-5xl text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400; line-height: 1.3;">
          {sectionTitle}
        </h2>
      </div>
    </section>

    <section class="w-full bg-[var(--bg-section)] pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24 mt-12 sm:mt-16 lg:mt-24">
      <div class="max-w-[1140px] mx-auto px-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
          <div class="md:col-span-6 order-2 md:order-1">
            <MediaFrame src={institutionalImage} alt="Corporate" />
          </div>
          <div class="md:col-span-5 order-1 md:order-2">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-4 sm:mb-6 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
              {institutionalTitle}
            </h2>
            <p class="text-base text-[#5c5c5c] leading-relaxed" style="font-family: Inter, sans-serif">
              {institutionalBody}
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="w-full section-white pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24 mt-12 sm:mt-16 lg:mt-24">
      <div class="max-w-[1140px] mx-auto px-8">
        <h2 class="text-4xl text-center text-[#2c2c2c] mb-10" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
          Product Groups
        </h2>

        <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
          {products.map((product) => (
            <a href={`/en/products/${product.slug}`} class="group">
              <MediaFrame src={product.image} alt={product.name} bgClass="bg-gray-200" marginBottom="mb-3" imgClass="group-hover:opacity-90 transition-opacity" />
              <p class="text-sm text-[#2c2c2c] group-hover:underline" style="font-family: Inter, sans-serif">
                {product.name}
              </p>
            </a>
          ))}
        </div>

        <div class="text-center mt-12">
          <a
            href="/en/products"
            class="inline-block btn-primary px-8 py-3"
            style="font-family: Inter, sans-serif"
          >
            View all products
          </a>
        </div>
      </div>
    </section>

    <section class="w-full bg-[var(--bg-section)] pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24 mt-12 sm:mt-16 lg:mt-24">
      <div class="max-w-[1140px] mx-auto px-8">
        <div class="grid grid-cols-2 md:grid-cols-12 gap-8">
          <div class="md:col-span-3 text-center">
            <div class="text-4xl sm:text-5xl lg:text-6xl mb-2 text-[#2c2c2c]" style="font-family: Inter, sans-serif; font-weight: 500;">
              150+
            </div>
            <div class="text-sm text-[#5c5c5c]" style="font-family: Inter, sans-serif">
              Global partners
            </div>
          </div>
          <div class="md:col-span-3 text-center">
            <div class="text-4xl sm:text-5xl lg:text-6xl mb-2 text-[#2c2c2c]" style="font-family: Inter, sans-serif; font-weight: 500;">
              25
            </div>
            <div class="text-sm text-[#5c5c5c]" style="font-family: Inter, sans-serif">
              Countries served
            </div>
          </div>
          <div class="md:col-span-3 text-center">
            <div class="text-4xl sm:text-5xl lg:text-6xl mb-2 text-[#2c2c2c]" style="font-family: Inter, sans-serif; font-weight: 500;">
              12
            </div>
            <div class="text-sm text-[#5c5c5c]" style="font-family: Inter, sans-serif">
              Commodity sectors
            </div>
          </div>
          <div class="md:col-span-3 text-center">
            <div class="text-4xl sm:text-5xl lg:text-6xl mb-2 text-[#2c2c2c]" style="font-family: Inter, sans-serif; font-weight: 500;">
              15+
            </div>
            <div class="text-sm text-[#5c5c5c]" style="font-family: Inter, sans-serif">
              Years of expertise
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="w-full section-white pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24 mt-12 sm:mt-16 lg:mt-24">
      <div class="max-w-[1140px] mx-auto px-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
          <div class="md:col-span-5 order-2 md:order-1">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-4 sm:mb-6 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
              Sustainable practices
            </h2>
            <p class="text-base text-[#5c5c5c] leading-relaxed" style="font-family: Inter, sans-serif">
              AFGT is committed to responsible trading practices that support long-term sustainability across our supply chains and partner networks.
            </p>
          </div>
          <div class="md:col-span-6 md:col-start-7 order-1 md:order-2">
            <MediaFrame src="https://images.unsplash.com/photo-1654436192650-7f5aa98954a5?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxhZ3JpY3VsdHVyYWwlMjBmaWVsZCUyMGhhcnZlc3R8ZW58MXx8fHwxNzcwNjk5Mjg2fDA&ixlib=rb-4.1.0&q=80&w=1080" alt="Agricultural field" />
          </div>
        </div>
      </div>
    </section>

    <section class="w-full bg-[var(--bg-section)] pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24 mt-12 sm:mt-16 lg:mt-24">
      <div class="max-w-[1140px] mx-auto px-8 text-center">
        <h2 class="text-2xl sm:text-4xl lg:text-5xl text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400; line-height: 1.3;">
          Connecting markets. Building trust.
        </h2>
      </div>
    </section>
  </div>

</BaseLayout>
