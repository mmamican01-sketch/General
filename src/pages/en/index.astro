---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MediaFrame from "../../components/MediaFrame.astro";
import { loadPageContent, getSlot, getHeroTitles, loadAllProducts } from "../../lib/contentStore";

const productDocs = loadAllProducts();
const products = productDocs.map((p) => ({
  name: p.title || p.slug,
  slug: p.slug,
  image: p.heroImage || "/assets/figma/media-default.svg",
}));

const content = await loadPageContent("index");
const heroVideo = getSlot(content, "hero-video", "");
function getYoutubeEmbedUrl(url: string): string {
  let id = "";
  if (url.includes("youtu.be/")) id = url.split("youtu.be/")[1]?.split("?")[0] || "";
  else if (url.includes("youtube.com/embed/")) id = url.split("embed/")[1]?.split("?")[0] || "";
  else if (url.includes("v=")) id = url.split("v=")[1]?.split("&")[0] || "";
  return id ? `https://www.youtube.com/embed/${id}?autoplay=1&mute=1&loop=1&playlist=${id}&controls=0&showinfo=0&playsinline=1` : "";
}
function getVimeoEmbedUrl(url: string): string {
  const id = url.split("vimeo.com/")[1]?.split("?")[0] || "";
  return id ? `https://player.vimeo.com/video/${id}?autoplay=1&loop=1&muted=1&background=1` : "";
}
const heroVideoEmbed = heroVideo.includes("youtube") || heroVideo.includes("youtu.be") ? getYoutubeEmbedUrl(heroVideo) : heroVideo.includes("vimeo.com") ? getVimeoEmbedUrl(heroVideo) : "";
const heroVideoDirect = heroVideo && /\.(mp4|webm|ogg)(\?|$)/i.test(heroVideo) ? heroVideo : "";
const heroTitles = getHeroTitles(content);
const heroHref = getSlot(content, "hero-link", "/en/who-we-are");
const heroLinkLabel = getSlot(content, "hero-link-label", "Who we are");
const sectionTitle = getSlot(
  content,
  "section-1-title",
  "Building global trade partnerships across diverse commodity sectors"
);
const institutionalImage = getSlot(
  content,
  "section-2-image",
  "https://images.unsplash.com/photo-1760246964044-1384f71665b9?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxjb3Jwb3JhdGUlMjBvZmZpY2UlMjBidWlsZGluZyUyMG1vZGVybnxlbnwxfHx8fDE3NzA3MTE3MjV8MA&ixlib=rb-4.1.0&q=80&w=1080"
);
const institutionalTitle = getSlot(content, "section-2-title", "Institutional excellence");
const institutionalBody = getSlot(
  content,
  "section-2-body",
  "AL Farhan General Trading (AFGT) operates with the highest standards of institutional integrity across global markets. Our commitment to transparency and reliability defines every partnership."
);
const stat1Number = getSlot(content, "stat-1-number", "150+");
const stat1Label = getSlot(content, "stat-1-label", "Global partners");
const stat2Number = getSlot(content, "stat-2-number", "25");
const stat2Label = getSlot(content, "stat-2-label", "Countries served");
const stat3Number = getSlot(content, "stat-3-number", "12");
const stat3Label = getSlot(content, "stat-3-label", "Commodity sectors");
const stat4Number = getSlot(content, "stat-4-number", "15+");
const stat4Label = getSlot(content, "stat-4-label", "Years of expertise");
const statsBannerImage = getSlot(content, "stats-banner-image", "");
const section3Title = getSlot(content, "section-3-title", "Sustainable practices");
const section3Body = getSlot(
  content,
  "section-3-body",
  "AFGT is committed to responsible trading practices that support long-term sustainability across our supply chains and partner networks."
);
const section3Image = getSlot(
  content,
  "section-3-image",
  "https://images.unsplash.com/photo-1654436192650-7f5aa98954a5?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxhZ3JpY3VsdHVyYWwlMjBmaWVsZCUyMGhhcnZlc3R8ZW58MXx8fHwxNzcwNjk5Mjg2fDA&ixlib=rb-4.1.0&q=80&w=1080"
);
const section4Title = getSlot(content, "section-4-title", "Connecting markets. Building trust.");
---

<BaseLayout
  title="ALFArhan General Trading Co. | Commodities Intermediary"
  description="Buyer-oriented access to bulk commodity trade across sugar, wheat, barley, and sunflower oil."
  lang="en"
  dir="ltr"
  locale="en"
  currentPath=""
>
  <div class="w-full">
    <section class="relative w-full h-[75vh] bg-[var(--bg-section)] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-gray-800 to-gray-900"></div>
      {heroVideoEmbed && (
        <div class="absolute inset-0 z-0 [&_iframe]:absolute [&_iframe]:top-1/2 [&_iframe]:left-1/2 [&_iframe]:min-w-[177.78vh] [&_iframe]:min-h-[56.25vw] [&_iframe]:w-[100vw] [&_iframe]:h-[56.25vw] [&_iframe]:-translate-x-1/2 [&_iframe]:-translate-y-1/2">
          <iframe
            src={heroVideoEmbed}
            class="pointer-events-none"
            allow="autoplay; encrypted-media"
            allowfullscreen
            title="Hero background video"
          />
        </div>
      )}
      {heroVideoDirect && (
        <video
          src={heroVideoDirect}
          autoplay
          muted
          loop
          playsinline
          class="absolute inset-0 z-0 w-full h-full object-cover"
          aria-hidden="true"
        />
      )}
      <div class="relative z-10 flex flex-col justify-between items-center w-full h-full min-h-[75vh] px-8 py-10">
        <div
          data-slot="hero-titles"
          data-hero-titles={JSON.stringify(heroTitles)}
          data-hero-video-type={heroVideoEmbed ? (heroVideo.includes("vimeo") ? "vimeo" : heroVideo.includes("youtube") || heroVideo.includes("youtu.be") ? "youtube" : "embed") : heroVideoDirect ? "direct" : "none"}
          class="flex-1 flex items-center justify-center w-full"
        >
          <h1
            id="hero-title-display"
            class="text-4xl sm:text-5xl lg:text-7xl text-white text-center transition-opacity duration-300"
            style="font-family: Cormorant Garamond, serif; font-weight: 400; line-height: 1.2;"
          >
            {heroTitles.length ? heroTitles[0].text : ""}
          </h1>
        </div>
        <a
          href={heroHref}
          class="inline-block btn-primary hero-cta shrink-0"
          style="font-family: Inter, sans-serif"
        >
          {heroLinkLabel}
        </a>
      </div>
    </section>

    <section class="w-full section-white pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24 mt-12 sm:mt-16 lg:mt-24">
      <div class="max-w-[1140px] mx-auto px-8 text-center">
        <h2 class="text-2xl sm:text-4xl lg:text-5xl text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400; line-height: 1.3;">
          {sectionTitle}
        </h2>
      </div>
    </section>

    <section class="w-full bg-[var(--bg-section)] pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24 mt-12 sm:mt-16 lg:mt-24">
      <div class="max-w-[1140px] mx-auto px-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
          <div class="md:col-span-6 order-2 md:order-1">
            <MediaFrame src={institutionalImage} alt="Corporate" />
          </div>
          <div class="md:col-span-5 order-1 md:order-2">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-4 sm:mb-6 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
              {institutionalTitle}
            </h2>
            <p class="text-base text-[#5c5c5c] leading-relaxed" style="font-family: Inter, sans-serif">
              {institutionalBody}
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="w-full section-white pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24 mt-12 sm:mt-16 lg:mt-24">
      <div class="max-w-[1140px] mx-auto px-8">
        <h2 class="text-4xl text-center text-[#2c2c2c] mb-10" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
          Product Groups
        </h2>

        <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
          {products.map((product) => (
            <a href={`/en/products/${product.slug}`} class="group">
              <MediaFrame src={product.image} alt={product.name} bgClass="bg-gray-200" marginBottom="mb-3" imgClass="group-hover:opacity-90 transition-opacity" />
              <p class="text-sm text-[#2c2c2c] group-hover:underline" style="font-family: Inter, sans-serif">
                {product.name}
              </p>
            </a>
          ))}
        </div>

        <div class="text-center mt-12">
          <a
            href="/en/products"
            class="inline-block btn-primary px-8 py-3"
            style="font-family: Inter, sans-serif"
          >
            View all products
          </a>
        </div>
      </div>
    </section>

    <section class={`relative w-full overflow-hidden pt-7 pb-7 sm:pt-9 sm:pb-9 lg:pt-14 lg:pb-14 mt-7 sm:mt-9 lg:mt-14 ${statsBannerImage ? '' : 'bg-[var(--bg-section)]'}`} data-slot="stats-banner-image">
      {statsBannerImage ? (
        <>
          <div class="absolute inset-0 z-0">
            <img src={statsBannerImage} alt="" class="w-full h-full object-cover" />
          </div>
          <div class="absolute inset-0 z-[1] bg-black/40" aria-hidden="true"></div>
        </>
      ) : null}
      <div class="relative z-10 max-w-[1140px] mx-auto px-8">
        <div class="grid grid-cols-2 md:grid-cols-12 gap-8">
          <div class="md:col-span-3 flex items-stretch gap-4">
            <div class="w-1 shrink-0 rounded-full bg-[var(--accent)]" aria-hidden="true"></div>
            <div class="flex flex-col justify-center">
              <div class={`text-4xl sm:text-5xl lg:text-6xl mb-1 ${statsBannerImage ? 'text-white' : 'text-[#2c2c2c]'}`} style="font-family: Inter, sans-serif; font-weight: 500;">
                {stat1Number}
              </div>
              <div class={`text-sm ${statsBannerImage ? 'text-white/90' : 'text-[#5c5c5c]'}`} style="font-family: Inter, sans-serif">
                {stat1Label}
              </div>
            </div>
          </div>
          <div class="md:col-span-3 flex items-stretch gap-4">
            <div class="w-1 shrink-0 rounded-full bg-[var(--accent)]" aria-hidden="true"></div>
            <div class="flex flex-col justify-center">
              <div class={`text-4xl sm:text-5xl lg:text-6xl mb-1 ${statsBannerImage ? 'text-white' : 'text-[#2c2c2c]'}`} style="font-family: Inter, sans-serif; font-weight: 500;">
                {stat2Number}
              </div>
              <div class={`text-sm ${statsBannerImage ? 'text-white/90' : 'text-[#5c5c5c]'}`} style="font-family: Inter, sans-serif">
                {stat2Label}
              </div>
            </div>
          </div>
          <div class="md:col-span-3 flex items-stretch gap-4">
            <div class="w-1 shrink-0 rounded-full bg-[var(--accent)]" aria-hidden="true"></div>
            <div class="flex flex-col justify-center">
              <div class={`text-4xl sm:text-5xl lg:text-6xl mb-1 ${statsBannerImage ? 'text-white' : 'text-[#2c2c2c]'}`} style="font-family: Inter, sans-serif; font-weight: 500;">
                {stat3Number}
              </div>
              <div class={`text-sm ${statsBannerImage ? 'text-white/90' : 'text-[#5c5c5c]'}`} style="font-family: Inter, sans-serif">
                {stat3Label}
              </div>
            </div>
          </div>
          <div class="md:col-span-3 flex items-stretch gap-4">
            <div class="w-1 shrink-0 rounded-full bg-[var(--accent)]" aria-hidden="true"></div>
            <div class="flex flex-col justify-center">
              <div class={`text-4xl sm:text-5xl lg:text-6xl mb-1 ${statsBannerImage ? 'text-white' : 'text-[#2c2c2c]'}`} style="font-family: Inter, sans-serif; font-weight: 500;">
                {stat4Number}
              </div>
              <div class={`text-sm ${statsBannerImage ? 'text-white/90' : 'text-[#5c5c5c]'}`} style="font-family: Inter, sans-serif">
                {stat4Label}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="w-full section-white pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24 mt-12 sm:mt-16 lg:mt-24">
      <div class="max-w-[1140px] mx-auto px-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
          <div class="md:col-span-5 order-2 md:order-1">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-4 sm:mb-6 text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400;">
              {section3Title}
            </h2>
            <p class="text-base text-[#5c5c5c] leading-relaxed" style="font-family: Inter, sans-serif">
              {section3Body}
            </p>
          </div>
          <div class="md:col-span-6 md:col-start-7 order-1 md:order-2">
            <MediaFrame src={section3Image} alt="Sustainable practices" />
          </div>
        </div>
      </div>
    </section>

    <section class="w-full bg-[var(--bg-section)] pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-24 mt-12 sm:mt-16 lg:mt-24">
      <div class="max-w-[1140px] mx-auto px-8 text-center">
        <h2 class="text-2xl sm:text-4xl lg:text-5xl text-[#2c2c2c]" style="font-family: Cormorant Garamond, serif; font-weight: 400; line-height: 1.3;">
          {section4Title}
        </h2>
      </div>
    </section>
  </div>

  {heroTitles.length > 0 && (heroVideoEmbed || heroVideoDirect) && (
    <script define:vars={{ heroTitlesJson: JSON.stringify(heroTitles), videoType: heroVideo.includes("vimeo") ? "vimeo" : heroVideo.includes("youtube") || heroVideo.includes("youtu.be") ? "youtube" : heroVideoDirect ? "direct" : "none" }}>
      (function () {
        let titles = [];
        try { titles = JSON.parse(heroTitlesJson || "[]"); } catch (_) {}
        const type = videoType;
        if (!titles.length || type === "none") return;

        const display = document.getElementById("hero-title-display");
        if (!display) return;

        function showTitleForTime(t) {
          const active = titles.find(function (x) { return t >= x.start && t <= x.end; });
          display.textContent = active ? active.text : "";
          display.style.opacity = active ? "1" : "0";
        }

        if (type === "direct") {
          const video = document.querySelector("video");
          if (!video) return;
          video.addEventListener("timeupdate", function () { showTitleForTime(video.currentTime); });
          showTitleForTime(0);
          return;
        }

        if (type === "vimeo") {
          const iframe = document.querySelector("iframe[src*='vimeo']");
          if (!iframe) return;
          var s = document.createElement("script");
          s.src = "https://player.vimeo.com/api/player.js";
          s.onload = function () {
            var Vimeo = window.Vimeo;
            if (!Vimeo || !Vimeo.Player) return;
            var player = new Vimeo.Player(iframe);
            var poll = function () {
              player.getCurrentTime().then(function (t) {
                showTitleForTime(t);
              }).catch(function () {});
              setTimeout(poll, 250);
            };
            player.getCurrentTime().then(function (t) { showTitleForTime(t); }).catch(function () {});
            setTimeout(poll, 300);
          };
          document.head.appendChild(s);
          return;
        }

        if (type === "youtube") {
          const iframe = document.querySelector("iframe[src*='youtube']");
          if (!iframe) return;
          var tag = document.createElement("script");
          tag.src = "https://www.youtube.com/iframe_api";
          var first = document.getElementsByTagName("script")[0];
          if (first && first.parentNode) first.parentNode.insertBefore(tag, first);
          window.onYouTubeIframeAPIReady = function () {
            var YT = window.YT;
            if (!YT || !YT.Player) return;
            var player = new YT.Player(iframe, {
              events: { onReady: function () {
                var poll = function () {
                  try {
                    var t = player.getCurrentTime();
                    if (typeof t === "number") showTitleForTime(t);
                  } catch (_) {}
                  requestAnimationFrame(poll);
                };
                poll();
              }},
            });
          };
        }
      })();
    </script>
  )}
</BaseLayout>
