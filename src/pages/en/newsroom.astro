---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import { loadPageContent, getSlot } from "../../lib/contentStore";

const locale = "en";
const content = await loadPageContent("newsroom");
---

<BaseLayout locale={locale} title="Newsroom">
  <section class="py-24 bg-[var(--bg-section)]">
    <Container>
      <h1 class="font-serif text-5xl text-white" style="font-weight:400; line-height:1.2;" data-slot="hero-title">{getSlot(content, "hero-title", "Newsroom")}</h1>
      <p class="mt-8 max-w-3xl text-lg leading-8 text-white/80" data-slot="hero-description">{getSlot(content, "hero-description", "Institutional notices and publication records for AFGT.")}</p>
    </Container>
  </section>

  <section class="py-24 section-white">
    <Container>
      <h2 class="font-serif text-4xl text-[#1b2230]" style="font-weight:400; line-height:1.2;" data-slot="section-1-title">{getSlot(content, "section-1-title", "Company Updates")}</h2>
      <p class="mt-8 max-w-3xl text-lg leading-8 text-[#1b2230]/70" data-slot="section-1-body">{getSlot(content, "section-1-body", "Operational and corporate updates will be published under this section.")}</p>
    </Container>
  </section>

  <section class="py-24 bg-[var(--bg-section)]">
    <Container>
      <h2 class="font-serif text-4xl text-[#1b2230]" style="font-weight:400; line-height:1.2;" data-slot="section-2-title">{getSlot(content, "section-2-title", "Announcements")}</h2>
      <p class="mt-8 max-w-3xl text-lg leading-8 text-[#1b2230]/70" data-slot="section-2-body">{getSlot(content, "section-2-body", "Formal announcements and release notes are maintained for reference.")}</p>
    </Container>
  </section>

  <section class="py-24 bg-[var(--bg-section)]">
    <Container>
      <h2 class="font-serif text-4xl text-white" style="font-weight:400; line-height:1.2;" data-slot="section-3-title">{getSlot(content, "section-3-title", "Media Inquiries")}</h2>
      <p class="mt-8 max-w-3xl text-lg leading-8 text-white/80" data-slot="section-3-body">{getSlot(content, "section-3-body", "Media and institutional communications follow the designated inquiry pathway.")}</p>
    </Container>
  </section>

  <section class="py-32 bg-[var(--bg-section)]">
    <Container>
      <div class="text-center">
      <h2 class="font-serif text-4xl text-white" style="font-weight:400; line-height:1.2;" data-slot="cta-title">{getSlot(content, "cta-title", "Engage With AFGT")}</h2>
      <a
        href={getSlot(content, "cta-link", "/en/contact")}
        class="mt-12 inline-block btn-primary px-10 py-4"
        data-slot="cta-link"
      >
        <span data-slot="cta-text">{getSlot(content, "cta-text", "Request Buyer Access")}</span>
      </a>
      </div>
    </Container>
  </section>
</BaseLayout>
