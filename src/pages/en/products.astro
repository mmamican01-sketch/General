---
import BaseLayout from "../../layouts/BaseLayout.astro";

const productRows = [
  {
    slug: "institutional-procurement-support",
    title: "Institutional Procurement Support",
    description: "",
  },
  {
    slug: "supplier-verification-alignment",
    title: "Supplier Verification Alignment",
    description: "",
  },
  {
    slug: "documentation-transaction-structure",
    title: "Documentation & Transaction Structure",
    description: "",
  },
  {
    slug: "execution-coordination",
    title: "Execution Coordination",
    description: "",
  },
];
---

<BaseLayout
  title="Products & Services | Structured Intermediary Models — ALFArhan"
  description="Institutional-facing product and service models for structured commodity engagement, supplier alignment, and execution support."
  lang="en"
  dir="ltr"
  locale="en"
  currentPath="products"
>
  <section class="py-24 bg-[#1b2230]">
    <div class="mx-auto max-w-[1140px] px-8 text-center">
      <p class="text-sm text-white/70" data-slot="breadcrumb"></p>
      <h1 class="mt-6 font-serif text-5xl text-white" style="font-weight:400; line-height:1.2;" data-slot="hero-title">
        Products & Services
      </h1>
      <p class="mt-8 text-lg leading-8 text-white/80" data-slot="hero-description"></p>
    </div>
  </section>

  <section class="py-24">
    <div class="mx-auto max-w-[1140px] px-8 space-y-16">
      {productRows.map((row, index) => (
        <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2">
          <div class={index % 2 === 1 ? "md:order-2" : undefined}>
            <h2 class="font-serif text-4xl text-[#1b2230]" style="font-weight:400; line-height:1.2;" data-slot={`row-${index + 1}-title`}>{row.title}</h2>
            <p class="mt-6 text-lg leading-8 text-[#1b2230]/80" data-slot={`row-${index + 1}-description`}>{row.description}</p>
            <a
              href={`/en/products/${row.slug}`}
              class="mt-8 inline-block border-b border-[#1b2230] pb-1 text-[#1b2230] transition-colors hover:text-[#1b2230]/70"
              data-slot={`row-${index + 1}-cta-link`}
            >
              <span data-slot={`row-${index + 1}-cta-text`}>View Details</span>
            </a>
          </div>
          <figure class={`h-[320px] w-full overflow-hidden ${index % 2 === 1 ? "md:order-1" : ""}`}>
            <img src="/assets/figma/card-default.svg" alt="" class="h-full w-full object-cover" loading="lazy" data-slot={`row-${index + 1}-image`} />
          </figure>
        </div>
      ))}
    </div>
  </section>

  <section class="py-32 bg-[#1b2230]">
    <div class="mx-auto max-w-[1140px] px-8 text-center">
      <h2 class="font-serif text-4xl text-white" style="font-weight:400; line-height:1.2;" data-slot="cta-title">
        Engage With A Structured Commodity Intermediary
      </h2>
      <a
        href="/en/contact"
        class="mt-12 inline-block rounded-full border border-white bg-white px-10 py-4 text-[#1b2230] transition-colors hover:bg-transparent hover:text-white"
        data-slot="cta-link"
      >
        <span data-slot="cta-text">Request Buyer Access</span>
      </a>
    </div>
  </section>
</BaseLayout>
